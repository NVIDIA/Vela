# The rejection paths of the project surface: unknown ids of every
# collection, paths outside the Data Roots, and requests that need a saved
# project. Each is an error reply with the request's id, never an Error
# message, and none of them changes the replica.

connect
list-roots
assert project.shots == 1
assert project.datasets == 0
assert project.lightRigs == 1
assert project.cameraRigs == 1

# Unknown ids.
expect-fail remove-shot shot_9999
expect-fail set-active-shot shot_9999
expect-fail rename-dataset dataset_9999 x
expect-fail remove-dataset dataset_9999
expect-fail load-dataset dataset_9999
expect-fail unload-dataset dataset_9999
expect-fail refresh-dataset-availability dataset_9999
expect-fail reimport-dataset dataset_9999
expect-fail save-dataset-archive dataset_9999 $dataRoot/x.vsr
expect-fail clone-light-rig lightRig_9999
expect-fail remove-light-rig lightRig_9999
expect-fail rename-light-rig lightRig_9999 x
expect-fail add-light lightRig_9999
expect-fail remove-light lightRig_9999 studio 0
expect-fail save-light-rig-archive lightRig_9999 $dataRoot/x.vsr
expect-fail remove-camera-rig cameraRig_9999
expect-fail rename-camera-rig cameraRig_9999 x
expect-fail save-camera-rig-archive cameraRig_9999 $dataRoot/x.vsr
expect-fail rename-color-map colorMap_9999 x
expect-fail remove-color-map colorMap_9999
expect-fail cancel-task 9999
assert replies.failed == 21

# Paths outside every Data Root are refused before anything is touched.
expect-fail open-project /nonexistent/project
expect-fail save-project /nonexistent/project
expect-fail import-static-dataset /etc/hostname Host OBJ
expect-fail load-dataset-archive /nonexistent/data.vsr
expect-fail save-light-rig-archive lightRig_0001 /nonexistent/rig.vsr
expect-fail load-light-rig-archive /nonexistent/rig.vsr
expect-fail save-camera-rig-archive cameraRig_0001 /nonexistent/rig.vsr
expect-fail load-camera-rig-archive /nonexistent/rig.vsr
expect-fail incorporate-dataset-candidate /nonexistent/data.vsr
expect-fail list-directory /nonexistent
assert replies.failed == 31

# An unsaved project has no directory to save to, and no candidates.
expect-fail save-project
discover-dataset-candidates
assert replies.failed == 32

# A path inside the root that holds no project is accepted as a task, which
# then fails.
open-project $dataRoot/nowhere
await-task expect-fail
assert tasks.failed == 1
assert tasks.completed == 0

# Nothing moved.
assert project.shots == 1
assert project.datasets == 0
assert project.lightRigs == 1
assert project.cameraRigs == 1
assert errors.received == 0

disconnect
