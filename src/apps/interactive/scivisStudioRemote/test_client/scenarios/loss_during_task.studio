#
# Server loss while a Server Task of this client runs. `kill-server` takes
# the spawned server away (SIGKILL) right after `await-task-progress` has
# seen the render under way, and starts a fresh one on the same port. Lost
# keeps the task record as it was; the reconnect's Bootstrap fails every
# record still open with "connection lost" (the restarted server knows
# nothing of the render, so it replays nothing), without counting it as a
# TaskFailed message.

copy-fixture fixtures/triangle.obj
connect
list-roots
import-static-dataset $dataRoot/triangle.obj Tri OBJ
await-task
await-snapshot
# Large enough that helide takes seconds over 400 frames: the kill lands
# while the render is under way.
update-shot active frameCount=400 renderSettings.width=512 renderSettings.height=384 renderSettings.samples=1
await-snapshot
save-project $dataRoot/lostproj
await-task
await-snapshot
no-wait render-shot active
await-reply
await-task-progress
assert task.last.state == Running

# The server goes away now, mid-render.
kill-server
await-lost timeout=20000
assert state == Lost
assert task.last.state == Running

await-server timeout=30000
reconnect timeout=10000
assert state == Connected
assert task.last.state == Failed
assert task.last.message == "connection lost"
assert tasks.replayed == 0
assert tasks.failed == 0
assert tasks.completed == 2

shutdown
assert state == Disconnected
