#
# runner: fixture fixtures/triangle.obj
# runner: kill-restart-after 13
#
# Server loss while a Server Task of this client runs. The runner kills the
# server (SIGKILL) once the client has printed thirteen `OK` records, that is
# right after `await-task-progress` has seen the render under way, and starts
# a fresh one on the same port. Lost keeps the task record as it was; the
# reconnect's Bootstrap fails every record still open with "connection lost"
# (the restarted server knows nothing of the render, so it replays nothing),
# without counting it as a TaskFailed message.

connect
list-roots
import-static-dataset $dataRoot/triangle.obj Tri OBJ
await-task
await-snapshot
update-shot active frameCount=400 renderSettings.width=32 renderSettings.height=24 renderSettings.samples=1
await-snapshot
save-project $dataRoot/lostproj
await-task
await-snapshot
no-wait render-shot active
await-reply
await-task-progress
assert task.last.state == Running

# The runner kills the server now.
await-lost timeout=20000
assert state == Lost
assert task.last.state == Running

reconnect timeout=45000
assert state == Connected
assert task.last.state == Failed
assert task.last.message == "connection lost"
assert tasks.replayed == 0
assert tasks.failed == 0
assert tasks.completed == 2

shutdown
assert state == Disconnected
