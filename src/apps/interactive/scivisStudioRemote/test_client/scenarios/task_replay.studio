#
# runner: fixture fixtures/triangle.obj
#
# Task-status replay: a render keeps running after its client disconnects,
# its TaskCompleted goes to a closed socket, and the next client's Bootstrap
# carries it (between UIState and the ProjectSnapshot) so the outcome is not
# lost. The reconnect is bootstrapped only once the render body returns, so
# `reconnect` waits for the whole render; the replayed end rebuilds the task
# record the disconnect had cleared.

connect
list-roots
import-static-dataset $dataRoot/triangle.obj Tri OBJ
await-task
await-snapshot

# Large enough that helide takes a second or two over 60 frames: the
# disconnect lands while the render is under way.
update-shot active frameCount=60 renderSettings.width=512 renderSettings.height=384 renderSettings.samples=1
await-snapshot
save-project $dataRoot/replayproj
await-task
await-snapshot

# Launch, make sure the render is under way, then leave.
no-wait render-shot active
await-reply
await-task-progress
assert task.last.state == Running
disconnect
sleep 200

# The Bootstrap arrives after the render completes and replays its end.
reconnect timeout=30000
assert tasks.replayed >= 1
assert task.last.state == Completed
assert task.last.framesCompleted == 60
assert project.dirty == false

# Nothing ended since: the next Bootstrap replays nothing.
disconnect
reconnect
assert tasks.replayed == 0

disconnect
