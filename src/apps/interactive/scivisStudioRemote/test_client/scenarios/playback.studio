# Playback: the server free-runs the active shot on its render loop, ticking
# at most one frame per iteration (fps is a ceiling), and every Frame header
# carries the frame that was actually rendered. SetPlaying is a Project Op
# (reply plus snapshot); stopping commits Time at Rest in the snapshot.
#
# A fresh unsaved project has one shot, shot_0001, which is the active shot;
# `active` names it without spelling the id.

connect
assert shot.active.playing == false

# A short looping shot at an fps ceiling well below the loop rate. Ticking
# goes on while a Frame is still on the wire (time must not freeze on a slow
# link) and the frame rendered meanwhile is dropped, latest-frame-wins; at a
# period near the wire's round trip (fps 1000 over a socket) that shows up
# as a header skipping a frame. The runner's frame slot is latest-wins too,
# so a scheduling stall of this process longer than one frame period (a
# loaded ctest -j run) would make consecutive headers skip although the
# server ticked one frame at a time. At 25 fps a stall must exceed 40 ms;
# the strict never-skip check lives in the in-process E2E test, whose client
# polls without printing.
update-shot active frameCount=12 fps=25 loop=on
await-snapshot
assert shot.active.frameCount == 12
assert shot.active.loop == true

set-encodings raw
set-frame-config 32 24
start-rendering
await-frame

set-playing active on
await-snapshot
assert shot.active.playing == true

# Five frames whose header frame differs from the previous one's. The tick
# advances at most one frame per loop iteration and never catches up by
# skipping, so no forward step between two consecutive headers exceeds 1
# unless this process missed a whole frame period (see above).
# The loop wrap 11 -> 0 is a step backwards, which frames.maxStep ignores by
# design (see the README's assert values).
await-frame-advance 5 timeout=10000
assert frames.advanced >= 5
assert frames.maxStep <= 1

# Stopping writes playing=false and the frame it stopped at into the shot.
set-playing active off
await-snapshot
assert shot.active.playing == false

# Frames after the stop are rendered at Time at Rest: the header agrees with
# the snapshot.
await-frame 2
assert shot.active.currentFrame == @frame.frame

# Playing a shot the project does not have is refused (an existing shot that
# is not the active one is refused too: "only the active shot can play").
expect-fail set-playing shot_9999 on
assert lastReplyError contains "shot not found"

stop-rendering
disconnect
